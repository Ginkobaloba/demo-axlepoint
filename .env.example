# Demo-axlepoint environment (chunk 4b portal federation).
#
# Copy to `.env.local` and fill in the values you want to override. None of
# these are required for `npm run dev` to boot - sensible defaults are baked
# in below - but in any deployed environment AXLE_PORTAL_SESSION_SECRET MUST
# be set to a real random 32+ character value.

# --- Paradigm Portal handoff ------------------------------------------------

# Where the portal's JWKS is published. Default points at the production
# portal subdomain.
PORTAL_JWKS_URL=https://portal.projectnexuscode.org/.well-known/jwks.json

# Exact issuer the portal will stamp into the JWT iss claim. We compare with
# a strict-equals; any mismatch is a hard reject.
PORTAL_EXPECTED_ISSUER=https://portal.projectnexuscode.org

# Audience this app expects in the JWT aud claim. The portal's app slug for
# AxlePoint is `axlepoint`; do not change unless the portal-shell app row's
# slug changes.
PORTAL_EXPECTED_AUD=axlepoint

# Secret used to sign the app-side session cookie minted after a successful
# portal handoff (HS256). Must be at least 32 chars. Rotate this and every
# active portal session is invalidated; users re-launch from the portal.
AXLE_PORTAL_SESSION_SECRET=replace-with-a-real-32-plus-char-random-secret
